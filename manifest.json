{
  "manifest_version": 3,
  "name": "Hello Kitty God Mode",
  "version": "3.0",
  "description": "Ultimate kawaii productivity browser extension",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Hello Kitty God Mode"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "kitty.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}