{
  "manifest_version": 3,
  "name": "Hello Kitty Ultra Final",
  "version": "5.0",
  "description": "Ultimate Sanrio productivity universe",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ]
}